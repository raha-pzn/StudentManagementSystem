@model StudentManagementSystem.Models.Course

<h1>Create New Course</h1>

<form asp-action="Create">
    <div class="form-group">
        <label asp-for="CourseName" class="control-label"></label>
        <input asp-for="CourseName" class="form-control" />
        <span asp-validation-for="CourseName" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="FacultyID" class="control-label"></label>
        <select asp-for="FacultyID" class="form-control" asp-items="ViewBag.Faculties"></select>
        <span asp-validation-for="FacultyID" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary" />
    </div>
</form>

<div>
    <a asp-action="Index">Back to List</a>
</div>