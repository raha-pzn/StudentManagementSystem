@model IEnumerable<StudentManagementSystem.Models.Student>

<h1>Students</h1>

<table class="table">
    <thead>
        <tr>
            <th>Student Name</th>
            <th>University</th>
            <th>Faculty</th>
            <th>Number of Units</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.StudentName</td>
                <td>@student.University.UniversityName</td>
                <td>@student.Faculty.FacultyName</td>
                <td>@student.NumberOfUnits</td>
                <td><a asp-action="Details" asp-route-id="@student.StudentID">Details</a></td>
            </tr>
        }
    </tbody>
</table>