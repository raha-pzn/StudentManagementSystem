@model StudentManagementSystem.Models.Faculty

@{
    ViewData["Title"] = "Update Faculty Name";
}

<h1>Update Faculty Name</h1>

<form asp-action="UpdateFacultyName" method="post">
    <input type="hidden" asp-for="FacultyID" /> <!-- Ensure this is included -->
    <input type="hidden" asp-for="UniversityID" /> <!-- Include UniversityID -->

    <div class="form-group">
        <label asp-for="FacultyName" class="control-label">New Faculty Name</label>
        <input asp-for="FacultyName" class="form-control" />
        <span asp-validation-for="FacultyName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Update" class="btn btn-primary" />
        <a asp-action="Details" asp-route-id="@Model.FacultyID" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}